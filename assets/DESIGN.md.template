# DESIGN.md — the design system as one file an agent reads before every build.
# Format: Google design.md (YAML tokens up top, prose with the WHY below). Token references use
# {group.name}. Values below are the AffiVN preset (Studio, 2026-09-29): replace them for another brand,
# keep the structure. Delete these comment lines in the real file.
name: <Tên sản phẩm> — <tính cách một cụm, vd "công cụ ấm, yên, chính xác">
colors:
  background: "#F2F0EB"      # ceramic — page
  surface: "#FFFFFF"         # the sheet / cards
  surface-subtle: "#F7F5F0"
  surface-2: "#EDEBE4"       # disabled fills, skeleton
  surface-3: "#E3E1D9"
  border: "#E8E6DE"
  border-strong: "#D6D3C9"
  text: "#1E3932"            # 12.6:1 on white
  text-2: "#37423D"          # 10.4:1
  text-3: "#6E6E68"          # 4.5:1 on background — smallest allowed contrast
  accent: "#00754A"          # primary buttons only; white text 5.8:1
  accent-hover: "#006241"
  accent-text: "#006241"     # green text / icons, focus ring
  tint: "#D4E9E2"            # selected, done, just-added wash
  house: "#1E3932"           # dark buttons, toasts
  gold: "#CBA258"            # ONLY finished output
  danger: "#C82014"
  warn: "#B7800A"            # slow work ahead — never an error
typography:
  family: "Be Vietnam Pro"   # 400 / 500 / 600 only, self-hosted, unicode-range subsets
  xs:  { fontSize: 12px, lineHeight: 1.5 }    # meta, counts, badges
  sm:  { fontSize: 13px, lineHeight: 1.5 }    # chips, captions
  md:  { fontSize: 14px, lineHeight: 1.5 }    # buttons, tabs, inputs, lists (default)
  lg:  { fontSize: 15px, lineHeight: 1.6 }    # reading: chat, editor
  xl:  { fontSize: 18px, lineHeight: 1.35, fontWeight: 600, letterSpacing: -0.01em }  # titles
  2xl: { fontSize: 26px, lineHeight: 1.25, fontWeight: 600, letterSpacing: -0.015em } # one headline
rounded:
  xs: 6px
  sm: 8px
  md: 12px     # inputs, rows, toasts
  lg: 16px     # cards, the sheet, video frames
  xl: 20px     # dialogs, the composer
  full: 999px  # buttons, chips, tabs
spacing: [2, 4, 6, 8, 12, 16, 20, 24, 32, 40, 48, 64]
elevation:
  card: "0 0 .5px rgba(30,57,50,.14), 0 1px 1px rgba(30,57,50,.18)"
  lift: "0 0 2px rgba(30,57,50,.10), 0 4px 8px rgba(30,57,50,.10), 0 12px 20px rgba(30,57,50,.08)"
  overlay: "0 12px 32px rgba(30,57,50,.18), 0 32px 80px rgba(30,57,50,.16)"
motion:
  ease: "cubic-bezier(.2,.8,.2,1)"
  fast: 120ms
  base: 180ms
  slow: 260ms
components:
  button-primary: { backgroundColor: "{colors.accent}", textColor: "#FFFFFF", rounded: "{rounded.full}", height: 36px, padding: "0 16px" }
  button-default: { backgroundColor: "{colors.surface}", textColor: "{colors.text}", border: "1px {colors.border-strong}", rounded: "{rounded.full}", height: 36px }
  button-disabled: { backgroundColor: "{colors.surface-2}", textColor: "{colors.text-3}" }
  input: { backgroundColor: "{colors.surface}", border: "1px {colors.surface-3}", rounded: "{rounded.md}", height: 40px, focus: "border {colors.accent-text} + 3px ring rgba(0,98,65,.16)" }
  card: { backgroundColor: "{colors.surface}", rounded: "{rounded.lg}", shadow: "{elevation.card}" }
  dialog: { backgroundColor: "{colors.surface}", rounded: "{rounded.xl}", shadow: "{elevation.overlay}", padding: 24px }
  toast: { backgroundColor: "{colors.house}", textColor: "#F2F0EB", rounded: "{rounded.md}", shadow: "{elevation.overlay}" }
